# Createch Hobbies — environment variables
#
# Copy to .env.local for local development. .env.local is gitignored; this file
# is not, so it must never contain a real key or secret.
#
# NOTE: this repository is PUBLIC. Anything committed here is world-readable the
# moment it is pushed. Real values belong in Vercel > Settings > Environment
# Variables (and .env.local locally) — never in a tracked file.

# ── WooCommerce REST API (server-side only) ─────────────────────────────────
# Products, categories and payment gateways are read with these.
# Generate under WooCommerce > Settings > Advanced > REST API (Read/Write).
WOO_URL=https://wp.example.co.ke
WOO_KEY=ck_replace_me
WOO_SECRET=cs_replace_me

# Public store URL used in customer-facing links (exposed to the browser).
NEXT_PUBLIC_WOO_STORE_URL=https://wp.example.co.ke

# ── Django order backend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Admin dashboard (/admin) ────────────────────────────────────────────────
ADMIN_PIN=replace_me
ADMIN_SECRET_KEY=replace_me

# ── iPay Africa card payments ───────────────────────────────────────────────
IPAY_VENDOR_ID=replace_me
IPAY_DATAKEY=replace_me

# ── Instant cache purge (optional) ──────────────────────────────────────────
# Shared secret for WooCommerce webhooks pointed at /api/revalidate. Set the SAME
# value here and in each webhook's "Secret" field (WooCommerce > Settings >
# Advanced > Webhooks), with delivery URL https://<your-domain>/api/revalidate
# and topics: Product created / updated / deleted / restored.
#
# Leave unset and the store still updates — just on its 60-second refresh cycle
# rather than instantly.
WC_WEBHOOK_SECRET=
